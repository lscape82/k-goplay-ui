<?xml version="1.0" encoding="UTF-8"?>
<!--
  광고플레이 프로토타입 — IIS 10 / ASP.NET 4.8 정적 호스팅용.
  정적 파일(HTML/CSS/JS)만 서빙하므로 .NET 코드 변환 불필요.
  권장: 기존 .NET 앱과 섞지 말고 '별도 사이트/애플리케이션'의 루트에 이 파일을 둘 것.
  (GitHub Pages는 web.config를 무시하므로 레포에 있어도 무해.)
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- 지도/데이터가 fetch 하는 .json 등 MIME 보장 (IIS 기본에 없을 경우 404 방지) -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <!-- 정적 파일 404 시 ASP.NET이 가로채지 않도록 -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
